{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"]
    // No `paths` for Atlas. Imports are bare `atlas/<pkg>` specifiers resolved
    // through that package's own `exports` map, which is the only spelling that
    // survives being installed as a dependency: Bun does not apply a consuming
    // project's tsconfig paths to files under node_modules, so an aliased
    // `@atlas/db` resolves here and fails the moment a site installs Inkling.
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "plugins/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
