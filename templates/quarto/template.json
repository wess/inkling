{
  "name": "quarto",
  "label": "Quarto",
  "version": "1.0.0",
  "author": "Inkling",
  "description": "A centred editorial column with a high-contrast serif and rules instead of boxes. Built to be read, not scanned.",
  "suits": "Writers, publications, and anyone whose site is mostly words.",
  "layout": {
    "nav": "stacked",
    "hero": "editorial",
    "cards": "plain",
    "align": "center",
    "rhythm": "airy"
  },
  "fonts": [
    {
      "family": "Fraunces",
      "weights": [
        400,
        600,
        700
      ],
      "italic": true,
      "stack": "\"Fraunces\", Georgia, \"Times New Roman\", serif"
    },
    {
      "family": "Newsreader",
      "weights": [
        400,
        500,
        600
      ],
      "italic": true,
      "stack": "\"Newsreader\", Georgia, serif"
    }
  ],
  "palettes": [
    {
      "id": "ink",
      "label": "Ink",
      "colors": {
        "bg": "#FBFAF7",
        "surface": "#F2EFE8",
        "text": "#1A1815",
        "textMuted": "#6B6459",
        "border": "#DDD7CB",
        "accent": "#7C2D12",
        "accentText": "#FBFAF7"
      }
    },
    {
      "id": "slate",
      "label": "Slate",
      "colors": {
        "bg": "#F7F8FA",
        "surface": "#ECEFF3",
        "text": "#16191F",
        "textMuted": "#5C6470",
        "border": "#D3D9E0",
        "accent": "#1F4E5F",
        "accentText": "#F7F8FA"
      }
    },
    {
      "id": "night",
      "label": "Night",
      "colors": {
        "bg": "#14120F",
        "surface": "#1F1C18",
        "text": "#F0EBE3",
        "textMuted": "#A39A8C",
        "border": "#322D26",
        "accent": "#D98E4A",
        "accentText": "#14120F"
      },
      "dark": true
    }
  ],
  "theme": [
    {
      "id": "color",
      "label": "Colour",
      "tokens": [
        {
          "key": "bg",
          "label": "Page background",
          "type": "color",
          "default": "#FBFAF7"
        },
        {
          "key": "surface",
          "label": "Panel background",
          "type": "color",
          "default": "#F2EFE8",
          "help": "Cards, quotes, and anything raised off the page."
        },
        {
          "key": "text",
          "label": "Text",
          "type": "color",
          "default": "#1A1815"
        },
        {
          "key": "textMuted",
          "label": "Secondary text",
          "type": "color",
          "default": "#6B6459",
          "help": "Captions, dates, and anything supporting."
        },
        {
          "key": "border",
          "label": "Lines",
          "type": "color",
          "default": "#DDD7CB"
        },
        {
          "key": "accent",
          "label": "Accent",
          "type": "color",
          "default": "#7C2D12",
          "help": "Links, buttons, and the one thing you want looked at."
        },
        {
          "key": "accentText",
          "label": "Text on accent",
          "type": "color",
          "default": "#FBFAF7",
          "help": "Must stay readable against the accent above."
        }
      ]
    },
    {
      "id": "type",
      "label": "Type",
      "tokens": [
        {
          "key": "fontDisplay",
          "label": "Headings",
          "type": "font",
          "default": "Fraunces"
        },
        {
          "key": "fontBody",
          "label": "Body",
          "type": "font",
          "default": "Newsreader"
        },
        {
          "key": "baseSize",
          "label": "Body size",
          "type": "number",
          "default": 19,
          "unit": "px"
        },
        {
          "key": "scale",
          "label": "Heading scale",
          "type": "number",
          "default": 1.32,
          "unit": "",
          "help": "How much larger each heading step is than the last."
        },
        {
          "key": "displayWeight",
          "label": "Heading weight",
          "type": "select",
          "default": "600",
          "options": [
            {
              "value": "400",
              "label": "Regular"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semibold"
            },
            {
              "value": "700",
              "label": "Bold"
            },
            {
              "value": "800",
              "label": "Extrabold"
            }
          ]
        },
        {
          "key": "displayTracking",
          "label": "Heading letter spacing",
          "type": "number",
          "default": -0.015,
          "unit": "em"
        },
        {
          "key": "displayCase",
          "label": "Heading case",
          "type": "select",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "As typed"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            }
          ]
        },
        {
          "key": "lineHeight",
          "label": "Body line height",
          "type": "number",
          "default": 1.7,
          "unit": ""
        }
      ]
    },
    {
      "id": "layout",
      "label": "Layout",
      "tokens": [
        {
          "key": "measure",
          "label": "Reading width",
          "type": "number",
          "default": 66,
          "unit": "ch",
          "help": "How many characters a line of text runs to."
        },
        {
          "key": "frame",
          "label": "Page width",
          "type": "number",
          "default": 760,
          "unit": "px"
        },
        {
          "key": "space",
          "label": "Spacing",
          "type": "number",
          "default": 1.6,
          "unit": "rem",
          "help": "The rhythm everything else is a multiple of."
        },
        {
          "key": "radius",
          "label": "Corner rounding",
          "type": "number",
          "default": 0,
          "unit": "px"
        },
        {
          "key": "borderWidth",
          "label": "Line weight",
          "type": "number",
          "default": 1,
          "unit": "px"
        }
      ]
    }
  ],
  "contentTypes": [
    {
      "name": "page",
      "label": "Page",
      "pluralLabel": "Pages",
      "kind": "collection",
      "icon": "file-text",
      "description": "A page, built from sections.",
      "fields": [
        {
          "key": "summary",
          "type": "textarea",
          "label": "Summary",
          "help": "Used for search results and link previews."
        },
        {
          "key": "sections",
          "type": "list",
          "label": "Sections",
          "help": "The page, in order.",
          "fields": [
            {
              "key": "type",
              "type": "select",
              "label": "Section",
              "required": true,
              "options": [
                {
                  "value": "hero",
                  "label": "Hero"
                },
                {
                  "value": "richtext",
                  "label": "Text"
                },
                {
                  "value": "features",
                  "label": "Feature grid"
                },
                {
                  "value": "gallery",
                  "label": "Gallery"
                },
                {
                  "value": "cta",
                  "label": "Call to action"
                },
                {
                  "value": "pullquote",
                  "label": "Pull quote"
                }
              ]
            },
            {
              "key": "heading",
              "type": "text",
              "label": "Heading"
            },
            {
              "key": "body",
              "type": "richtext",
              "label": "Body"
            },
            {
              "key": "image",
              "type": "media",
              "label": "Image"
            },
            {
              "key": "images",
              "type": "gallery",
              "label": "Images"
            },
            {
              "key": "ctaLabel",
              "type": "text",
              "label": "Button label"
            },
            {
              "key": "ctaUrl",
              "type": "url",
              "label": "Button link"
            }
          ]
        }
      ]
    },
    {
      "name": "post",
      "label": "Post",
      "pluralLabel": "Posts",
      "kind": "collection",
      "icon": "pen-line",
      "description": "A dated piece of writing.",
      "fields": [
        {
          "key": "excerpt",
          "type": "textarea",
          "label": "Excerpt",
          "required": true,
          "help": "Shown on the index and in link previews."
        },
        {
          "key": "cover",
          "type": "media",
          "label": "Cover image"
        },
        {
          "key": "body",
          "type": "richtext",
          "label": "Body",
          "required": true
        }
      ]
    },
    {
      "name": "author",
      "label": "Author",
      "pluralLabel": "Authors",
      "kind": "collection",
      "icon": "user",
      "description": "Someone who writes here.",
      "fields": [
        {
          "key": "bio",
          "type": "textarea",
          "label": "Bio"
        },
        {
          "key": "portrait",
          "type": "media",
          "label": "Portrait"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Website"
        }
      ]
    }
  ],
  "sections": [
    {
      "name": "hero",
      "label": "Hero",
      "description": "The opening statement, with an optional image and one action.",
      "fields": [
        {
          "key": "heading",
          "type": "text",
          "label": "Heading",
          "required": true
        },
        {
          "key": "subheading",
          "type": "textarea",
          "label": "Subheading"
        },
        {
          "key": "image",
          "type": "media",
          "label": "Image"
        },
        {
          "key": "ctaLabel",
          "type": "text",
          "label": "Button label"
        },
        {
          "key": "ctaUrl",
          "type": "url",
          "label": "Button link"
        }
      ]
    },
    {
      "name": "richtext",
      "label": "Text",
      "description": "A block of writing.",
      "fields": [
        {
          "key": "body",
          "type": "richtext",
          "label": "Body",
          "required": true
        }
      ]
    },
    {
      "name": "features",
      "label": "Feature grid",
      "description": "Three or more things, side by side.",
      "fields": [
        {
          "key": "heading",
          "type": "text",
          "label": "Heading"
        },
        {
          "key": "items",
          "type": "list",
          "label": "Items",
          "fields": [
            {
              "key": "title",
              "type": "text",
              "label": "Title",
              "required": true
            },
            {
              "key": "body",
              "type": "textarea",
              "label": "Description"
            },
            {
              "key": "image",
              "type": "media",
              "label": "Image"
            }
          ]
        }
      ]
    },
    {
      "name": "gallery",
      "label": "Gallery",
      "description": "A set of images.",
      "fields": [
        {
          "key": "heading",
          "type": "text",
          "label": "Heading"
        },
        {
          "key": "images",
          "type": "gallery",
          "label": "Images",
          "required": true
        }
      ]
    },
    {
      "name": "cta",
      "label": "Call to action",
      "description": "A closing prompt.",
      "fields": [
        {
          "key": "heading",
          "type": "text",
          "label": "Heading",
          "required": true
        },
        {
          "key": "body",
          "type": "textarea",
          "label": "Body"
        },
        {
          "key": "label",
          "type": "text",
          "label": "Button label"
        },
        {
          "key": "url",
          "type": "url",
          "label": "Button link"
        }
      ]
    },
    {
      "name": "pullquote",
      "label": "Pull quote",
      "description": "A line lifted out of the writing and set large.",
      "fields": [
        {
          "key": "quote",
          "type": "textarea",
          "label": "Quote",
          "required": true
        },
        {
          "key": "attribution",
          "type": "text",
          "label": "Attribution"
        }
      ]
    }
  ]
}
