# ---------------------------------------------------------------------------
# Inkling — environment reference. Copy to `.env` and fill in.
# Every variable Inkling reads is listed here; `src/config/index.ts` is the
# only place they are consumed.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
# Runtime mode. Production refuses to boot with the development signing secret
# and emits a minified admin bundle with production security headers.
NODE_ENV=development

# One process, one port. The admin, the API, the delivery surface, and media all
# answer on this origin and are separated by path:
#
#   /            the admin
#   /api/…       everything that needs a session
#   /content,/site   the delivery API (API key)
#   /media/file  media blobs
#   /preview     share links
#   /ext         plugin routes
#   /realtime    the WebSocket
#
# 4300 rather than 4000: Docker Desktop binds *:4000 on IPv6, which wins
# `localhost` resolution and silently answers requests meant for us.
PORT=4300
HOST=0.0.0.0

# The public origin of all of the above. Media on the local storage driver is
# stored root-relative and resolved against this, so consuming sites on another
# origin get a URL they can actually fetch. Set it to your real hostname behind
# a proxy or TLS terminator.
PUBLIC_URL=http://localhost:4300

# Comma-separated origins allowed to call the delivery API from a browser.
# Server-to-server delivery calls (the usual case) don't need this.
# Use `*` to allow any origin — safe here because delivery reads require an
# API key, which a browser shouldn't be holding in the first place.
DELIVERY_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Postgres, in every environment including local development. Running the same
# engine everywhere is the point: dialect differences that only show up in
# production are not worth the convenience of a file.
#
# The SQLite driver still exists and the test suite uses it in memory, so
# `bun test` needs no running database. It is not a supported store for an
# actual install.
#
# This is also the unit of separation between sites. Inkling is single-tenant:
# core settings live under one 'site' scope, menu names are globally unique, and
# PUBLIC_URL above is one origin per process. A delivery key's scopes partition
# content *types*, not sites. So running three sites means three databases and
# three of these files — they may share a Postgres server and a bucket, but not
# a schema, and each wants its own SECRET so a rotation stops at one site.
#
# One instance can still serve several sites that are genuinely one property:
# same team, same settings, same menus, a scoped key per site.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/inkling
DB_POOL_SIZE=5

# --- Secrets ----------------------------------------------------------------
# Sign session JWTs. Generate with: openssl rand -hex 32
SECRET=change-me-openssl-rand-hex-32

# --- Storage ----------------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR; `s3` targets any S3-compatible bucket —
# AWS, DigitalOcean Spaces, Cloudflare R2, MinIO, Backblaze B2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# S3_ENDPOINT is the *regional* host, without the bucket in it — the bucket is
# addressed path-style. Set S3_REGION to match the endpoint's region; it is what
# the request signature is computed over, so a mismatch fails as a signature
# error rather than as anything that mentions the region.
#
#   DigitalOcean Spaces   https://nyc3.digitaloceanspaces.com    nyc3
#   Cloudflare R2         https://<account>.r2.cloudflarestorage.com  auto
#   MinIO                 http://localhost:9000                  us-east-1
#   AWS                   https://s3.us-east-1.amazonaws.com     us-east-1
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional. Confines this install to one folder inside the bucket, so several
# sites can share a bucket and you can still tell whose media is whose — back up
# or delete one site's blobs without reading its database.
#
# The prefix is bucket layout, not content: it never enters `storage_key` or a
# /media/file URL. So adding, changing, or dropping it later is an env change
# plus a blob copy, never a data migration. Leave it blank for one site alone in
# a bucket.
S3_PREFIX=

# Optional. A CDN or public base that serves the bucket directly, and the only
# thing that makes media bypass this process on the way to a browser.
#
# Leave it blank and uploads are stored root-relative, exactly as on the local
# driver: a browser fetches them from /media/file/… and Inkling streams them out
# of the bucket. That is the safe default, because buckets on every provider
# here are private when created — publishing the bucket URL instead would hand
# consuming sites links that 403.
#
# Setting it also changes how uploads are written: objects go up `public-read`,
# because a public base in front of private objects is a CDN that 403s on every
# image. The two settings are one decision.
#
# Two consequences of serving the bucket directly, both worth knowing before you
# set this. Media stops being read through /media/file, so a soft-deleted item
# keeps answering on its old URL until it is purged — the delivery API stops
# listing it either way. And the URL becomes the whole of the access control, as
# it already is on the local driver: keys carry 8 bytes of randomness for exactly
# that reason. Grant the bucket anonymous GetObject, never ListBucket.
#
# On Spaces that means the CDN endpoint, e.g.
# https://wessdev.nyc3.cdn.digitaloceanspaces.com
S3_PUBLIC_URL=

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Plugins ----------------------------------------------------------------
# Directory scanned for plugin packages at boot.
PLUGIN_DIR=./plugins
# Plugins enabled automatically on a fresh database (comma-separated).
PLUGIN_AUTOENABLE=seo,redirects

# --- Security ---------------------------------------------------------------
# CIDRs / IPs of proxies allowed to set X-Forwarded-For. Empty = trust none.
#
# SET THIS IF YOU RUN BEHIND A PROXY, and it is not only a hardening knob — it
# is a correctness one, in both directions. Rate-limit buckets key on the client
# address, and `src/security#clientIp` reads the real socket peer, never a
# client-supplied header, unless that peer is listed here.
#
# Behind Caddy or nginx the peer is the proxy, the same address for every
# request on earth. So the per-IP login limit stops being per-IP: it becomes one
# global bucket of 30 attempts per 15 minutes that any single client can exhaust
# for everybody. The per-account bucket still protects individual accounts, so
# the failure is availability rather than a way in — but it is a way to lock a
# team out of their own site.
#
# In Docker behind a host proxy this is usually the bridge gateway:
#   TRUSTED_PROXIES=172.17.0.0/16
# Same host, no container: 127.0.0.1/32. Only list addresses you control —
# anything listed here is trusted to say who its client is.
TRUSTED_PROXIES=

# Webhooks are the one place an operator hands this process a URL and tells it
# to make a request, which makes them a way to reach whatever Inkling can reach:
# the database port, sibling containers, and on every cloud host a metadata
# service that hands credentials to anyone asking from the right address. The
# receiver's status comes back in the API response, so unguarded this is a port
# scanner with a signature attached.
#
# So private, loopback, and link-local targets are refused — at the moment the
# URL is saved, again when it fires, and redirects are not followed. Set this to
# true only if your receiver genuinely is on a private network.
WEBHOOK_ALLOW_PRIVATE=false

# --- Bootstrap --------------------------------------------------------------
# Optional unattended setup. Normally the first admin visit creates the owner;
# when these are set on an empty database, the account is created at boot.
# Either way the first account is always an owner — there is no public signup,
# and the setup flow closes permanently once one exists.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Owner

# --- AI -----------------------------------------------------------------------
# Nothing is required here. Provider credentials are entered in the admin and
# stored encrypted (AES-GCM under a key derived from SECRET) rather than living
# in the environment, so rotating a key does not mean a redeploy.
#
# Two consequences worth knowing: rotating SECRET invalidates stored provider
# credentials the same way it invalidates sessions, and the assistant is simply
# absent from the admin until someone connects a provider.
#
# The variables below are the exception, and only for the second way to connect:
# OAuth. An OAuth client is registered *with the provider* against a specific
# redirect URI, so unlike an API key it cannot be pasted into the admin — there
# is nothing self-hosted software could ship that stands in for a registration
# on your domain. Set a client id and the admin offers "Continue with …" for
# that provider; leave it blank and only the API-key path is shown.
#
# Register the client with this redirect URI (PUBLIC_URL + the path):
#   http://localhost:4300/ai/oauth/callback
#
# AUTHORIZE_URL / TOKEN_URL / SCOPES override the defaults we ship, and are what
# let you wire up a provider we ship no defaults for at all.
AI_OAUTH_ANTHROPIC_CLIENT_ID=
AI_OAUTH_ANTHROPIC_CLIENT_SECRET=
AI_OAUTH_ANTHROPIC_AUTHORIZE_URL=
AI_OAUTH_ANTHROPIC_TOKEN_URL=
AI_OAUTH_ANTHROPIC_SCOPES=

AI_OAUTH_OPENAI_CLIENT_ID=
AI_OAUTH_OPENAI_CLIENT_SECRET=
AI_OAUTH_OPENAI_AUTHORIZE_URL=
AI_OAUTH_OPENAI_TOKEN_URL=
AI_OAUTH_OPENAI_SCOPES=

# ---------------------------------------------------------------- Social
#
# These are optional, and mostly historical. Social networks are set up in the
# admin — **Social → Settings**, one row per network, with a walkthrough behind
# the "?" on each one. Credentials entered there are sealed with SECRET, the
# same as AI credentials and account tokens.
#
# The variables below still work and are read for any network with no row in
# the admin, so an install configured before that screen existed keeps running
# untouched. A network configured both ways uses the admin's.
#
# Prefer the admin. It is the only one of the two that can tell you the network
# is registered against the wrong redirect URI before you find out from a failed
# connection, and turning a network off does not need a redeploy.
#
# Register every app against this exact redirect URI (PUBLIC_URL + the path):
#   http://localhost:4300/social/oauth/callback
#
# Supported: X, FACEBOOK, INSTAGRAM, THREADS, LINKEDIN, TIKTOK, YOUTUBE,
# PINTEREST, GOOGLEBUSINESS. Each takes _CLIENT_ID, _CLIENT_SECRET, and
# optionally _AUTHORIZE_URL, _TOKEN_URL, and _SCOPES to override the shipped
# defaults.
#
# One thing no variable can fix: FACEBOOK, INSTAGRAM, THREADS, PINTEREST, and
# GOOGLEBUSINESS *download* media from your site rather than being handed it, so
# posts carrying images or video need PUBLIC_URL to be an address they can
# reach. From localhost those five fail and the other four do not.
SOCIAL_OAUTH_X_CLIENT_ID=
SOCIAL_OAUTH_X_CLIENT_SECRET=

SOCIAL_OAUTH_FACEBOOK_CLIENT_ID=
SOCIAL_OAUTH_FACEBOOK_CLIENT_SECRET=

SOCIAL_OAUTH_INSTAGRAM_CLIENT_ID=
SOCIAL_OAUTH_INSTAGRAM_CLIENT_SECRET=

SOCIAL_OAUTH_THREADS_CLIENT_ID=
SOCIAL_OAUTH_THREADS_CLIENT_SECRET=

SOCIAL_OAUTH_LINKEDIN_CLIENT_ID=
SOCIAL_OAUTH_LINKEDIN_CLIENT_SECRET=

SOCIAL_OAUTH_TIKTOK_CLIENT_ID=
SOCIAL_OAUTH_TIKTOK_CLIENT_SECRET=

SOCIAL_OAUTH_YOUTUBE_CLIENT_ID=
SOCIAL_OAUTH_YOUTUBE_CLIENT_SECRET=

SOCIAL_OAUTH_PINTEREST_CLIENT_ID=
SOCIAL_OAUTH_PINTEREST_CLIENT_SECRET=

SOCIAL_OAUTH_GOOGLEBUSINESS_CLIENT_ID=
SOCIAL_OAUTH_GOOGLEBUSINESS_CLIENT_SECRET=
