# ---------------------------------------------------------------------------
# Inkling — environment reference. Copy to `.env` and fill in.
# Every variable Inkling reads is listed here; `src/config/index.ts` is the
# only place they are consumed.
# ---------------------------------------------------------------------------

# --- HTTP -------------------------------------------------------------------
# Runtime mode. Production refuses to boot with the development signing secret
# and emits a minified admin bundle with production security headers.
NODE_ENV=development

# One process, one port. The admin, the API, the delivery surface, and media all
# answer on this origin and are separated by path:
#
#   /            the admin
#   /api/…       everything that needs a session
#   /content,/site   the delivery API (API key)
#   /media/file  media blobs
#   /preview     share links
#   /ext         plugin routes
#   /realtime    the WebSocket
#
# 4300 rather than 4000: Docker Desktop binds *:4000 on IPv6, which wins
# `localhost` resolution and silently answers requests meant for us.
PORT=4300
HOST=0.0.0.0

# The public origin of all of the above. Media on the local storage driver is
# stored root-relative and resolved against this, so consuming sites on another
# origin get a URL they can actually fetch. Set it to your real hostname behind
# a proxy or TLS terminator.
PUBLIC_URL=http://localhost:4300

# Comma-separated origins allowed to call the delivery API from a browser.
# Server-to-server delivery calls (the usual case) don't need this.
# Use `*` to allow any origin — safe here because delivery reads require an
# API key, which a browser shouldn't be holding in the first place.
DELIVERY_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Postgres, in every environment including local development. Running the same
# engine everywhere is the point: dialect differences that only show up in
# production are not worth the convenience of a file.
#
# The SQLite driver still exists and the test suite uses it in memory, so
# `bun test` needs no running database. It is not a supported store for an
# actual install.
#
# This is also the unit of separation between sites. Inkling is single-tenant:
# core settings live under one 'site' scope, menu names are globally unique, and
# PUBLIC_URL above is one origin per process. A delivery key's scopes partition
# content *types*, not sites. So running three sites means three databases and
# three of these files — they may share a Postgres server and a bucket, but not
# a schema, and each wants its own SECRET so a rotation stops at one site.
#
# One instance can still serve several sites that are genuinely one property:
# same team, same settings, same menus, a scoped key per site.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/inkling
DB_POOL_SIZE=5

# --- Secrets ----------------------------------------------------------------
# Sign session JWTs. Generate with: openssl rand -hex 32
SECRET=change-me-openssl-rand-hex-32

# --- Storage ----------------------------------------------------------------
# `local` writes to STORAGE_LOCAL_DIR; `s3` targets any S3-compatible bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional CDN/public base for uploaded objects. Falls back to the S3 URL.
S3_PUBLIC_URL=

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400

# --- Plugins ----------------------------------------------------------------
# Directory scanned for plugin packages at boot.
PLUGIN_DIR=./plugins
# Plugins enabled automatically on a fresh database (comma-separated).
PLUGIN_AUTOENABLE=seo,redirects

# --- Security ---------------------------------------------------------------
# CIDRs / IPs of proxies allowed to set X-Forwarded-For. Empty = trust none.
TRUSTED_PROXIES=

# --- Bootstrap --------------------------------------------------------------
# Optional unattended setup. Normally the first admin visit creates the owner;
# when these are set on an empty database, the account is created at boot.
# Either way the first account is always an owner — there is no public signup,
# and the setup flow closes permanently once one exists.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=Owner

# --- AI -----------------------------------------------------------------------
# Nothing is required here. Provider credentials are entered in the admin and
# stored encrypted (AES-GCM under a key derived from SECRET) rather than living
# in the environment, so rotating a key does not mean a redeploy.
#
# Two consequences worth knowing: rotating SECRET invalidates stored provider
# credentials the same way it invalidates sessions, and the assistant is simply
# absent from the admin until someone connects a provider.
#
# The variables below are the exception, and only for the second way to connect:
# OAuth. An OAuth client is registered *with the provider* against a specific
# redirect URI, so unlike an API key it cannot be pasted into the admin — there
# is nothing self-hosted software could ship that stands in for a registration
# on your domain. Set a client id and the admin offers "Continue with …" for
# that provider; leave it blank and only the API-key path is shown.
#
# Register the client with this redirect URI (PUBLIC_URL + the path):
#   http://localhost:4300/ai/oauth/callback
#
# AUTHORIZE_URL / TOKEN_URL / SCOPES override the defaults we ship, and are what
# let you wire up a provider we ship no defaults for at all.
AI_OAUTH_ANTHROPIC_CLIENT_ID=
AI_OAUTH_ANTHROPIC_CLIENT_SECRET=
AI_OAUTH_ANTHROPIC_AUTHORIZE_URL=
AI_OAUTH_ANTHROPIC_TOKEN_URL=
AI_OAUTH_ANTHROPIC_SCOPES=

AI_OAUTH_OPENAI_CLIENT_ID=
AI_OAUTH_OPENAI_CLIENT_SECRET=
AI_OAUTH_OPENAI_AUTHORIZE_URL=
AI_OAUTH_OPENAI_TOKEN_URL=
AI_OAUTH_OPENAI_SCOPES=
