{
  "name": "inkling",
  "version": "1.23.3",
  "description": "A headless CMS with a plugin system and an agent that can work the whole of it.",
  "type": "module",
  "license": "MIT",
  "author": "Wess Cope",
  "homepage": "https://wess.io/inkling/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wess/inkling.git"
  },
  "bugs": "https://github.com/wess/inkling/issues",
  "keywords": [
    "cms",
    "headless-cms",
    "bun",
    "typescript",
    "postgres"
  ],
  "private": true,
  "exports": {
    ".": "./src/app.ts",
    "./server": "./src/server.ts",
    "./visual": "./src/visual/index.ts",
    "./plugins": "./src/plugins/api.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/start.ts",
    "seed": "bun scripts/seed.ts",
    "sites": "bun scripts/sites.ts",
    "password": "bun scripts/password.ts",
    "mcp": "bun scripts/mcp.ts",
    "templates": "bun templates/preview.ts",
    "docs": "bun scripts/docs.ts",
    "test": "bun test tests/",
    "typecheck": "bunx tsc --noEmit",
    "lint": "biome lint src/ plugins/ scripts/ tests/ templates/",
    "format": "biome format src/ plugins/ scripts/ tests/ templates/",
    "check": "biome check src/ plugins/ scripts/ tests/ templates/",
    "tidy": "biome check --write src/ plugins/ scripts/ tests/ templates/",
    "check:atlas": "bunx --package https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-cli-0.4.7.tgz atlas check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@wess/atlas": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-0.4.7.tgz",
    "@wess/atlas-ai": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-ai-0.4.7.tgz",
    "@wess/atlas-server": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-server-0.4.7.tgz",
    "@wess/atlas-auth": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-auth-0.4.7.tgz",
    "@wess/atlas-db": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-db-0.4.7.tgz",
    "@wess/atlas-config": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-config-0.4.7.tgz",
    "@wess/atlas-security": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-security-0.4.7.tgz",
    "@wess/atlas-storage": "https://github.com/wess/atlas/releases/download/v0.4.7/wess-atlas-storage-0.4.7.tgz"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
